{
  "name": "thz-lang-workspace",
  "version": "2.4.0",
  "private": true,
  "description": "Orquestrador do ecossistema THZ-LANG: engine Java (produção) com API Spring Boot para web.",
  "scripts": {
    "// === Setup (one-click) ===": "",
    "setup": "node scripts/run-script.js setup",
    "setup:skipTests": "node scripts/run-script.js setup -SkipTests",
    "health": "node scripts/run-script.js health-check",
    "build:jvm": "node scripts/run-script.js build-jvm",
    "build:jvm:skipTests": "node scripts/run-script.js build-jvm -SkipTests",

    "// === Testes (tudo) ===": "",
    "test": "node scripts/run-script.js gradle:test",
    "test:core": "node scripts/run-script.js gradle :thz-core-jvm:test",
    "test:gui": "node scripts/run-script.js gradle :thz-gui-jvm:test",
    "test:api": "node scripts/run-script.js gradle :thz-api-jvm:test",
    "test:lsp": "node scripts/run-script.js gradle :thz-lsp-jvm:test",
    "test:cli": "node scripts/run-script.js gradle :thz-cli-jvm:test",

    "// === CLI / REPL / IDE (padrão: WebView) ===": "",
    "thz": "node scripts/thz.js",
    "thz:gui": "node scripts/run-script.js gui",
    "thz:gui:swing": "node scripts/run-script.js gui -Swing",
    "repl": "node scripts/thz.js repl",
    "ide": "node scripts/run-script.js gui",
    "ide:swing": "node scripts/run-script.js gui -Swing",

    "// === Documentação & Livro-Manual PDF ===": "",
    "livro": "node scripts/thz.js livro --saida dist/MANUAL_THZ_LANG.pdf",
    "manual": "node scripts/thz.js livro --saida dist/MANUAL_THZ_LANG.pdf",
    "doc": "node scripts/run-script.js run doc",

    "// === API REST (target web) ===": "",
    "api:build": "node scripts/run-script.js gradle :thz-api-jvm:bootJar",
    "api:run": "node scripts/run-script.js gradle :thz-api-jvm:bootRun",
    "api:test": "node scripts/run-script.js gradle :thz-api-jvm:test",

    "// === LSP Server (Java) ===": "",
    "lsp:build": "node scripts/run-script.js gradle :thz-lsp-jvm:shadowJar",
    "lsp:jar": "node scripts/run-script.js gradle :thz-lsp-jvm:shadowJar",
    "lsp:run": "node scripts/run-script.js gradle :thz-lsp-jvm:run --args=\"--stdio\"",

    "// === Extensão VS Code / VSIX ===": "",
    "ext:compile": "npm run compile --prefix Extensions/thz-lsp-vscode",
    "ext:package": "node scripts/run-script.js build-vsix",
    "vsix:build": "node scripts/run-script.js build-vsix",
    "vsix:install": "node scripts/run-script.js build-vsix -Instalar",

    "// === Scripts de Automação Cross-Platform ===": "",
    "clean": "node scripts/run-script.js clean",
    "clean:deep": "node scripts/run-script.js clean -Deep",
    "dev": "node scripts/run-script.js dev",
    "dev:api": "node scripts/run-script.js dev -ApiOnly",
    "package": "node scripts/run-script.js package-all",
    "package:native": "node scripts/run-script.js package-all -WithNative",
    "fmt": "node scripts/run-script.js fmt",

    "// === Módulos JVM individuais ===": "",
    "core:publish": "node scripts/run-script.js gradle :thz-core-jvm:publishToMavenLocal",
    "cli:jar": "node scripts/run-script.js gradle :thz-cli-jvm:shadowJar",
    "cli:native": "node scripts/run-script.js build-native",
    "cli:package": "node scripts/run-script.js package-all",

    "// === Benchmarks (JMH) ===": "",
    "bench": "node scripts/run-script.js gradle :thz-bench-jvm:jmh",
    "bench:decimal": "node scripts/run-script.js gradle :thz-bench-jvm:jmh -Pbenchmark=DecimalBench",
    "bench:memoria": "node scripts/run-script.js gradle :thz-bench-jvm:jmh -Pbenchmark=BlocoMemoriaBench",
    "bench:layout": "node scripts/run-script.js gradle :thz-bench-jvm:jmh -Pbenchmark=LayoutBench",
    "bench:build": "node scripts/run-script.js gradle :thz-bench-jvm:build",

    "// === Contêineres (Docker & Podman) ===": "",
    "docker:build": "node scripts/run-script.js docker build",
    "docker:up": "node scripts/run-script.js docker up",
    "docker:down": "node scripts/run-script.js docker down",
    "docker:api": "node scripts/run-script.js docker api",
    "docker:cli": "node scripts/run-script.js docker cli",
    "docker:repl": "node scripts/run-script.js docker repl",
    "docker:test": "node scripts/run-script.js docker test",
    "docker:dev": "node scripts/run-script.js docker dev",
    "podman:build": "node scripts/run-script.js docker build --podman",
    "podman:up": "node scripts/run-script.js docker up --podman",
    "podman:down": "node scripts/run-script.js docker down --podman",
    "podman:api": "node scripts/run-script.js docker api --podman",
    "podman:cli": "node scripts/run-script.js docker cli --podman",
    "podman:repl": "node scripts/run-script.js docker repl --podman",
    "podman:test": "node scripts/run-script.js docker test --podman",
    "podman:dev": "node scripts/run-script.js docker dev --podman"
  }
}
