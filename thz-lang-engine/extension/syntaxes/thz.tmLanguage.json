{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "THZ-LANG",
  "scopeName": "source.thz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#contracts" },
    { "include": "#declarations" },
    { "include": "#control-flow" },
    { "include": "#memory-simd" },
    { "include": "#stdlib" },
    { "include": "#metadata-keys" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#logical-operators" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.thz",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.thz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.thz",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.thz",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.thz",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.other.contract.thz",
          "match": "\\b(CONTRATO_ENTRADA|FIM_CONTRATO_ENTRADA|CONTRATO_SAIDA|FIM_CONTRATO_SAIDA|EXIGE|GARANTE|INVARIANTE)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.thz",
          "match": "\\b(PROGRAMA|FIM_PROGRAMA|METADADOS_ARQUITETURA|FIM_METADADOS|ESTRUTURA|FIM_ESTRUTURA|ENUMERACAO|FIM_ENUMERACAO|REGRA_NEGOCIO|FIM_REGRA_NEGOCIO|PROCEDIMENTO|OPERACAO|VARIAVEL|VERSAO_LINGUAGEM|CRIAR)\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.thz",
          "match": "\\b(INICIO|FIM|SE|SENAO|FIM_SE|ENQUANTO|FIM_ENQUANTO|PARA|DE|ATE|PASSO|FIM_PARA|RETORNE|FALHAR_COM|EXIBA|LER)\\b"
        }
      ]
    },
    "memory-simd": {
      "patterns": [
        {
          "name": "keyword.other.memory.thz",
          "match": "\\b(USAR_BLOCO_MEMORIA|FIM_BLOCO_MEMORIA|VETORIZAR_PARA|LAYOUT_COLUNAR|EM|PASSO_SIMD|ARENA_EPHEMERAL)\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.thz",
          "match": "\\b(TEXTO|MATEMATICA|DATA|TELA|GUI)\\b(?=\\.)"
        },
        {
          "name": "support.function.thz",
          "match": "(?<=\\.)(comprimento|maiusculas|minusculas|aparar|contem|subtexto|substituir|dividir|juntar|abs|min|max|potencia|raiz|arredondar|aleatorio|hoje|agora|criar|criarDataHora|adicionarDias|adicionarHoras|diferencaDias|ano|mes|dia|diaDaSemana|texto|renderizarFormulario|alerta|confirmar|pedirTexto)\\b"
        }
      ]
    },
    "metadata-keys": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.thz",
          "match": "\\b(DOMINIO|SUBDOMINIO|CAMADA|VERSAO|AUTOR|SLO_LATENCIA_MAXIMA|CONFORMIDADE|IDENTIFICADOR_REGRA|RASTREIO_REQUISITO|DESCRICAO)(?=\\s*:)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.thz",
          "match": "\\b(TEXTO|LOGICO|UUID|DATA|DATA_HORA|NATURAL8|NATURAL16|NATURAL32|NATURAL64|INTEIRO8|INTEIRO16|INTEIRO32|INTEIRO64|DECIMAL|MONETARIO|FATIA|RESULTADO|LISTA)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.thz",
          "match": "\\b(VERDADEIRO|FALSO|NULO)\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.thz",
          "match": "\\b(E|OU|NAO)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.thz",
          "match": "<-"
        },
        {
          "name": "keyword.operator.comparison.thz",
          "match": "(<=|>=|<>|=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.thz",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.thz",
          "match": "(:|,)"
        },
        {
          "name": "punctuation.bracket.thz",
          "match": "(\\(|\\)|\\[|\\])"
        }
      ]
    }
  }
}
