{
  "name": "THZ",
  "scopeName": "source.thz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.number-sign.thz", "match": "#.*$" }] },
    "strings": { "patterns": [{ "name": "string.quoted.double.thz", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.thz", "match": "\\\\n" }] }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.thz", "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?\\b" }] },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.thz",
          "match": "\\b(PROGRAMA|FIM_PROGRAMA|METADADOS_ARQUITETURA|FIM_METADADOS|ESTRUTURA|FIM_ESTRUTURA|ENUMERACAO|FIM_ENUMERACAO|REGRA_NEGOCIO|FIM_REGRA_NEGOCIO|PROCEDIMENTO|OPERACAO|VARIAVEL|VERSAO_LINGUAGEM|CONTRATO_ENTRADA|FIM_CONTRATO_ENTRADA|CONTRATO_SAIDA|FIM_CONTRATO_SAIDA|EXIGE|GARANTE|INVARIANTE|INICIO|FIM|SE|SENAO|FIM_SE|ENQUANTO|FIM_ENQUANTO|PARA|DE|ATE|PASSO|VETORIZAR_PARA|FIM_PARA|USAR_BLOCO_MEMORIA|FIM_BLOCO_MEMORIA|RETORNE|FALHAR_COM|EXIBA|LER|CRIAR|LAYOUT_COLUNAR|EM|PASSO_SIMD)\\b"
        },
        { "name": "keyword.operator.logical.thz", "match": "\\b(E|OU|NAO)\\b" },
        { "name": "constant.language.thz", "match": "\\b(VERDADEIRO|FALSO|NULO)\\b" }
      ]
    },
    "types": { "patterns": [{ "name": "entity.name.type.thz", "match": "\\b(TEXTO|LOGICO|UUID|DATA|DATA_HORA|NATURAL8|NATURAL16|NATURAL32|NATURAL64|INTEIRO8|INTEIRO16|INTEIRO32|INTEIRO64|DECIMAL|MONETARIO|FATIA|RESULTADO|LISTA)\\b" }] },
    "operators": { "patterns": [{ "name": "keyword.operator.thz", "match": "<-|=|<>|<=|>=|<|>|\\+|-|\\*|/|%" }] }
  }
}
