PROGRAMA CalculoTemporalFolha

# --- METADADOS ARQUITETURAIS DE RH E CONTABILIDADE ---
METADADOS_ARQUITETURA
    DOMINIO: "RecursosHumanosEContabilidade"
    SUBDOMINIO: "FolhaPagamentoBeneficios"
    CAMADA: "Dominio"
    VERSAO: "2.4.0"
    AUTOR: "Lucas Thomaz"
    SLO_LATENCIA_MAXIMA: "20ms"
    CONFORMIDADE: "CLT-Brasil", "ISO-10967", "eSocial-2026"
FIM_METADADOS

ESTRUTURA FuncionarioContrato
    matricula       : TEXTO
    data_admissao   : DATA
    salario_base    : DECIMAL(12, 4)
    horas_normais   : INTEIRO32
    horas_extras    : INTEIRO32

    INVARIANTE salario_base > 0.0000
    INVARIANTE horas_normais >= 0
    INVARIANTE horas_extras >= 0
FIM_ESTRUTURA

ESTRUTURA HoleriteCalculado
    matricula         : TEXTO
    tempo_casa_dias   : INTEIRO64
    salario_bruto     : DECIMAL(14, 4)
    desconto_inss     : DECIMAL(14, 4)
    salario_liquido   : DECIMAL(14, 4)
    data_emissao      : DATA
FIM_ESTRUTURA

REGRA_NEGOCIO MotorCalculoFolha
    IDENTIFICADOR_REGRA: "BR-RH-FOLHA-2026"
    RASTREIO_REQUISITO: "REQ-CLT-7801"
    DESCRICAO: "Processa folha mensal calculando tempo de casa com biblioteca DATA e arredondamento bancário ISO."

    CONTRATO_ENTRADA
        EXIGE funcionario.salario_base > 0.0000
    FIM_CONTRATO_ENTRADA

    CONTRATO_SAIDA
        GARANTE RESULTADO.salario_liquido > 0.0000
    FIM_CONTRATO_SAIDA

    OPERACAO CalcularHolerite(funcionario: FuncionarioContrato, data_referencia: DATA): HoleriteCalculado
    INICIO
        # 1. Operações da biblioteca DATA
        VARIAVEL dias_trabalhados : INTEIRO64 <- DATA.diferencaDias(data_referencia, funcionario.data_admissao)
        VARIAVEL dia_semana : INTEIRO64 <- DATA.diaDaSemana(data_referencia)
        VARIAVEL ano_ref : INTEIRO64 <- DATA.ano(data_referencia)
        VARIAVEL mes_ref : INTEIRO64 <- DATA.mes(data_referencia)
        VARIAVEL data_vencimento : DATA <- DATA.adicionarDias(data_referencia, 5)

        EXIBA "[FOLHA] Processando competencia " + mes_ref + "/" + ano_ref + " para matricula " + funcionario.matricula + " (Dias: " + dias_trabalhados + ")"

        # 2. Cálculos de remuneração com MATEMATICA e decimais exatos
        VARIAVEL valor_hora : DECIMAL(12, 4) <- funcionario.salario_base / 220
        VARIAVEL adicional_extra : DECIMAL(12, 4) <- valor_hora * 1.5000 * funcionario.horas_extras
        VARIAVEL bruto_calculado : DECIMAL(14, 4) <- funcionario.salario_base + adicional_extra

        # 3. Arredondamento e funções matemáticas auxiliares
        VARIAVEL fator_inss : DECIMAL(5, 4) <- 0.1100
        VARIAVEL valor_inss_bruto : DECIMAL(14, 4) <- bruto_calculado * fator_inss
        VARIAVEL inss_arredondado : DECIMAL(14, 4) <- MATEMATICA.arredondar(valor_inss_bruto, 2)
        VARIAVEL liquido_final : DECIMAL(14, 4) <- bruto_calculado - inss_arredondado

        # Validações matemáticas adicionais
        VARIAVEL piso_garantido : INTEIRO64 <- MATEMATICA.max(1412, 1000)
        VARIAVEL bonus_tempo : INTEIRO64 <- MATEMATICA.min(dias_trabalhados, 3650)

        VARIAVEL holerite : HoleriteCalculado <- CRIAR HoleriteCalculado(
            matricula: funcionario.matricula,
            tempo_casa_dias: dias_trabalhados,
            salario_bruto: bruto_calculado,
            desconto_inss: inss_arredondado,
            salario_liquido: liquido_final,
            data_emissao: data_referencia
        )

        EXIBA "[HOLERITE GERADO] Matrícula: " + funcionario.matricula + " | Bruto: R$ " + bruto_calculado + " | Líquido: R$ " + liquido_final
        RETORNE holerite
    FIM
FIM_REGRA_NEGOCIO

FIM_PROGRAMA
