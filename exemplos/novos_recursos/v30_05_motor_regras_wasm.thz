PROGRAMA MotorTributarioWasm

METADADOS_ARQUITETURA
    DOMINIO: "FiscalDistribuido"
    SUBDOMINIO: "CalculadoraNavegador"
    CAMADA: "Dominio"
    VERSAO: "3.0.0"
    AUTOR: "Lucas Thomaz"
    SLO_LATENCIA_MAXIMA: "1ms"
    CONFORMIDADE: "ISO-IEC-10967"
FIM_METADADOS

REGRA_NEGOCIO CalcularImpostoSimples
    OPERACAO Executar() : DECIMAL
    INICIO
        EXIBA "=== MOTOR TRIBUTARIO PORTAVEL PARA WEBASSEMBLY (WASM) ==="
        VARIAVEL faturamentoMensal: DECIMAL <- 32000.00
        VARIAVEL aliquotaEfetiva: DECIMAL <- 0.06

        VARIAVEL impostoDevido: DECIMAL <- faturamentoMensal * aliquotaEfetiva
        EXIBA "Faturamento: R$ " + TEXTO.deDecimal(faturamentoMensal)
        EXIBA "Imposto Devido (6%): R$ " + TEXTO.deDecimal(impostoDevido)

        RETORNE impostoDevido
    FIM
FIM_REGRA_NEGOCIO

FIM_PROGRAMA
