PROGRAMA ConciliacaoContabilAuditavel

METADADOS_ARQUITETURA
    DOMINIO: "Contabilidade"
    SUBDOMINIO: "PartidasDobradas"
    CAMADA: "Dominio"
    VERSAO: "2.9.0"
    AUTOR: "Lucas Thomaz"
    SLO_LATENCIA_MAXIMA: "5ms"
    CONFORMIDADE: "ISO-IEC-10967"
FIM_METADADOS

REGRA_NEGOCIO AuditarBalanco
    OPERACAO Executar() : LOGICO
    INICIO
        VARIAVEL totalDebitos : DECIMAL <- 158420.50
        VARIAVEL totalCreditos : DECIMAL <- 158420.50

        EXIBA "=== CONCILIACAO CONTABIL DE PARTIDAS DOBRADAS ==="
        EXIBA "Total Debitos:  R$ " + TEXTO.deDecimal(totalDebitos)
        EXIBA "Total Creditos: R$ " + TEXTO.deDecimal(totalCreditos)

        VARIAVEL diferenca : DECIMAL <- totalDebitos - totalCreditos
        EXIBA "Diferenca de Balanco: R$ " + TEXTO.deDecimal(diferenca)

        SE diferenca = 0.00 ENTAO
            EXIBA "Status: BALANCO 100% CONCILIADO E AUDITADO"
        SENAO
            EXIBA "Status: ERRO DE FECHAMENTO CONTABIL"
        FIM_SE

        RETORNE VERDADEIRO
    FIM
FIM_REGRA_NEGOCIO

FIM_PROGRAMA
