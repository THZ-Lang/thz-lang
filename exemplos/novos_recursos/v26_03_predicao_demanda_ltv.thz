PROGRAMA PredicaoLtvCliente

METADADOS_ARQUITETURA
    DOMINIO: "MarketingEVendas"
    SUBDOMINIO: "ValorDoCliente"
    CAMADA: "Servico"
    VERSAO: "2.6.0"
    AUTOR: "Lucas Thomaz"
    SLO_LATENCIA_MAXIMA: "10ms"
    CONFORMIDADE: "ISO-IEC-10967"
FIM_METADADOS

REGRA_NEGOCIO EstimarLtvFuturo
    IDENTIFICADOR_REGRA: "LTV-ML-03"
    RASTREIO_REQUISITO: "REQ-MKT-303"
    DESCRICAO: "Prediz o Lifetime Value esperado atraves de regressao linear continua."

    OPERACAO Executar() : LOGICO
    INICIO
        VARIAVEL metricas: TEXTO <- "[24.0, 350.00, 9.0]"
        VARIAVEL coeficientes: TEXTO <- "[120.0, 3.5, 45.0]"
        VARIAVEL intercepto: DECIMAL <- 500.00

        VARIAVEL ltvEstimado: DECIMAL <- ML.predizer(metricas, coeficientes, intercepto)

        EXIBA "=== PREVISAO DE LIFETIME VALUE (LTV) ==="
        EXIBA "LTV Estimado para o cliente: R$ " + TEXTO.deDecimal(ltvEstimado)

        RETORNE VERDADEIRO
    FIM
FIM_REGRA_NEGOCIO

FIM_PROGRAMA
