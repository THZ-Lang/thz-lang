PROGRAMA ValidadorDocumentoWasm

METADADOS_ARQUITETURA
    DOMINIO: "CadastrosGlobais"
    SUBDOMINIO: "ValidacaoEdge"
    CAMADA: "Dominio"
    VERSAO: "3.0.0"
    AUTOR: "Lucas Thomaz"
    SLO_LATENCIA_MAXIMA: "1ms"
    CONFORMIDADE: "ISO-IEC-10967"
FIM_METADADOS

REGRA_NEGOCIO ValidarDigitoVerificador
    OPERACAO Executar() : LOGICO
    INICIO
        EXIBA "=== VALIDACAO NUMERICA NO TARGET WEBASSEMBLY / EDGE ==="
        VARIAVEL baseDoc : INTEIRO <- 12345678
        VARIAVEL dvEsperado : INTEIRO <- 9

        VARIAVEL resto : INTEIRO <- baseDoc % 11
        VARIAVEL valido : LOGICO <- (resto = dvEsperado)

        EXIBA "Documento Base: " + TEXTO.deInteiro(baseDoc)
        EXIBA "Digito Verificador: " + TEXTO.deInteiro(resto)
        EXIBA "Documento Valido: " + TEXTO.deLogico(valido)

        RETORNE valido
    FIM
FIM_REGRA_NEGOCIO

FIM_PROGRAMA
