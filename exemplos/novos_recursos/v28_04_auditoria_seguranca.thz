PROGRAMA AuditoriaSegurancaAcessos

METADADOS_ARQUITETURA
    DOMINIO: "SegurancaDaInformacao"
    SUBDOMINIO: "TrilhaAuditoria"
    CAMADA: "Servico"
    VERSAO: "2.8.0"
    AUTOR: "Lucas Thomaz"
    SLO_LATENCIA_MAXIMA: "10ms"
    CONFORMIDADE: "ISO-IEC-10967", "LGPD-Art7"
FIM_METADADOS

ESTRUTURA EventoAcesso
    usuario: TEXTO
    ipOrigem: TEXTO
    sucesso: LOGICO
FIM_ESTRUTURA

REGRA_NEGOCIO RegistrarTrilhaAcesso
    OPERACAO Executar() : LOGICO
    INICIO
        VARIAVEL topicoSeguranca : TEXTO <- "seguranca.auditoria.logins"
        MENSAGERIA.limparTopico(topicoSeguranca)

        VARIAVEL evt : EventoAcesso <- CRIAR EventoAcesso(usuario: "admin_corp", ipOrigem: "192.168.1.100", sucesso: VERDADEIRO)
        MENSAGERIA.publicar(topicoSeguranca, evt)

        EXIBA "=== TRILHA DE AUDITORIA DE SEGURANCA ==="
        VARIAVEL auditado : EventoAcesso <- MENSAGERIA.consumir(topicoSeguranca, 50)
        EXIBA "Auditoria registrada: Usuario " + auditado.usuario + " de IP " + auditado.ipOrigem

        RETORNE VERDADEIRO
    FIM
FIM_REGRA_NEGOCIO

FIM_PROGRAMA
