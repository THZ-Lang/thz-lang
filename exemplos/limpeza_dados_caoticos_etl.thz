PROGRAMA DemonstracaoLimpezaDadosCaoticosEtl

# ==============================================================================
# THZ-LANG v3.0.0 — Data Quality & Sanitização de Dados Caóticos Corporativos
# ==============================================================================

METADADOS_ARQUITETURA
    DOMINIO: "DataEngineeringDataQuality"
    SUBDOMINIO: "HigienizacaoSanitizacao"
    CAMADA: "Integracao"
    VERSAO: "3.0.0"
    AUTOR: "Lucas Thomaz"
    SLO_LATENCIA_MAXIMA: "15ms"
    CONFORMIDADE: "LGPD-Art7", "ISO-IEC-10967"
FIM_METADADOS

ESTRUTURA RegistroCru
    cnpj: TEXTO
    dataNf: TEXTO
    valorBruto: TEXTO
FIM_ESTRUTURA

REGRA_NEGOCIO ProcessarDataQuality
    OPERACAO Executar() : LOGICO
    INICIO
        EXIBA "================================================================================"
        EXIBA "   DEMONSTRACAO THZ-LANG: TRATAMENTO DE CAOS DE DADOS E DATA QUALITY"
        EXIBA "================================================================================"

        # 1. Parsing Resiliente de Moedas em Formatos Caóticos Reais
        EXIBA "1. Normalizacao de Valores Monetarios e Contabeis Sujos..."
        VARIAVEL v1: TEXTO <- " R$ 1.250.450,75 "
        VARIAVEL v2: TEXTO <- "(450,20)"
        VARIAVEL v3: TEXTO <- "- 1500.50"

        VARIAVEL d1: DECIMAL <- DADOS.decimalPtBr(v1)
        VARIAVEL d2: DECIMAL <- DADOS.decimalPtBr(v2)
        VARIAVEL d3: DECIMAL <- DADOS.decimalPtBr(v3)

        EXIBA "-> Parse de '" + v1 + "' => R$ " + TEXTO.deDecimal(d1)
        EXIBA "-> Parse Contabil de '" + v2 + "' => R$ " + TEXTO.deDecimal(d2)
        EXIBA "-> Parse Negativo de '" + v3 + "' => R$ " + TEXTO.deDecimal(d3)

        # 2. Normalização de Datas em Múltiplos Formatos Híbridos
        EXIBA "2. Padronizacao Canonica ISO (YYYY-MM-DD) de Datas Mistas..."
        VARIAVEL dtBr: TEXTO <- DADOS.dataPtBr("25/08/2026")
        VARIAVEL dtIsoHora: TEXTO <- DADOS.dataPtBr("2026-08-25 14:30:00")
        VARIAVEL dtPonto: TEXTO <- DADOS.dataPtBr("25.08.26")

        EXIBA "-> 25/08/2026         => " + dtBr
        EXIBA "-> 2026-08-25 14:30:00 => " + dtIsoHora
        EXIBA "-> 25.08.26           => " + dtPonto

        # 3. Validação de Documentos Oficiais (CPF / CNPJ) e Mascaramento LGPD
        EXIBA "3. Validacao de CPF / CNPJ e Mascaramento de Privacidade LGPD..."
        VARIAVEL cnpjValido: TEXTO <- "11.222.333/0001-81"
        VARIAVEL cnpjInvalido: TEXTO <- "00.000.000/0000-00"
        VARIAVEL cpfTitular: TEXTO <- "529.982.247-25"

        EXIBA "-> CNPJ 11.222.333/0001-81 e Valido? " + TEXTO.deLogico(DADOS.validarCnpj(cnpjValido))
        EXIBA "-> CNPJ 00.000.000/0000-00 e Valido? " + TEXTO.deLogico(DADOS.validarCnpj(cnpjInvalido))
        EXIBA "-> CPF 529.982.247-25 e Valido?       " + TEXTO.deLogico(DADOS.validarCpf(cpfTitular))

        VARIAVEL cpfProtegido: TEXTO <- DADOS.mascarar(cpfTitular, 3, 2)
        EXIBA "-> CPF Anonimizado conforme LGPD: " + cpfProtegido

        # 4. Deduplicação em Lote de Dataset Corporativo
        EXIBA "4. Deduplicacao de Registros Duplicados por Chave Composta..."
        VARIAVEL r1: RegistroCru <- CRIAR RegistroCru(cnpj: "11222333000181", dataNf: "2026-08-25", valorBruto: "100.00")
        VARIAVEL r2: RegistroCru <- CRIAR RegistroCru(cnpj: "11222333000181", dataNf: "2026-08-25", valorBruto: "100.00")
        VARIAVEL r3: RegistroCru <- CRIAR RegistroCru(cnpj: "11222333000181", dataNf: "2026-08-26", valorBruto: "250.00")

        VARIAVEL loteSujo: FATIA[RegistroCru] <- [r1, r2, r3]
        VARIAVEL loteLimpo: FATIA[REGISTRO] <- DADOS.removerDuplicatas(loteSujo, ["cnpj", "dataNf"])

        EXIBA "-> Total de Linhas Antes: " + TEXTO.deInteiro(FATIA.tamanho(loteSujo))
        EXIBA "-> Total de Linhas Higienizadas Apos Deduplicacao: " + TEXTO.deInteiro(FATIA.tamanho(loteLimpo))

        RETORNE VERDADEIRO
    FIM
FIM_REGRA_NEGOCIO

FIM_PROGRAMA
