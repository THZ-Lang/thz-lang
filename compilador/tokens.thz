BIBLIOTECA CompiladorTokens

METADADOS_ARQUITETURA
    DOMINIO: "Compiladores"
    SUBDOMINIO: "Lexico"
    CAMADA: "Core"
    VERSAO: "1.0.0"
    AUTOR: "THZ Self-Hosting Project"
    SLO_LATENCIA_MAXIMA: "1ms"
    CRITICIDADE: "ALTA"
FIM_METADADOS

ENUMERACAO TokenTipo
    PALAVRA_CHAVE_PROGRAMA
    PALAVRA_CHAVE_BIBLIOTECA
    PALAVRA_CHAVE_METADADOS
    PALAVRA_CHAVE_FIM_METADADOS
    PALAVRA_CHAVE_ESTRUTURA
    PALAVRA_CHAVE_FIM_ESTRUTURA
    PALAVRA_CHAVE_REGRA_NEGOCIO
    PALAVRA_CHAVE_FIM_REGRA_NEGOCIO
    PALAVRA_CHAVE_EXIGE
    PALAVRA_CHAVE_GARANTE
    PALAVRA_CHAVE_INVARIANTE
    PALAVRA_CHAVE_OPERACAO
    PALAVRA_CHAVE_VARIAVEL
    PALAVRA_CHAVE_RETORNE
    PALAVRA_CHAVE_EXIBA
    PALAVRA_CHAVE_FIM
    IDENTIFICADOR
    LITERAL_TEXTO
    LITERAL_INTEIRO
    LITERAL_DECIMAL
    OPERADOR_ATRIBUICAO
    OPERADOR_SOMA
    OPERADOR_SUBTRACAO
    OPERADOR_MULTIPLICACAO
    OPERADOR_DIVISAO
    OPERADOR_MAIOR_IGUAL
    OPERADOR_MENOR_IGUAL
    OPERADOR_IGUAL
    ABRE_PARENTESE
    FECHA_PARENTESE
    DOIS_PONTOS
    FIM_DE_ARQUIVO
FIM_ENUMERACAO

ESTRUTURA Token
    tipo   : TEXTO
    valor  : TEXTO
    linha  : INTEIRO32
    coluna : INTEIRO32
FIM_ESTRUTURA

REGRA_NEGOCIO CriarToken
    IDENTIFICADOR_REGRA: "BR-COMP-001"
    RASTREIO_REQUISITO: "REQ-COMP-001"
    DESCRICAO: "Instancia um novo Token de codigo-fonte com rastreabilidade de linha e coluna."

    CONTRATO_ENTRADA
        EXIGE linha > 0
        EXIGE coluna > 0
    FIM_CONTRATO_ENTRADA

    OPERACAO NovoToken(tipo: TEXTO, valor: TEXTO, linha: INTEIRO32, coluna: INTEIRO32) : Token
    INICIO
        VARIAVEL t : Token <- CRIAR Token(tipo: tipo, valor: valor, linha: linha, coluna: coluna)
        RETORNE t
    FIM
FIM_REGRA_NEGOCIO

FIM_BIBLIOTECA
