FERRAMENTA CompiladorLexerSelfHost

METADADOS_ARQUITETURA
    DOMINIO: "Compiladores"
    SUBDOMINIO: "Lexico"
    CAMADA: "Core"
    VERSAO: "1.1.0"
    AUTOR: "THZ Self-Hosting Project"
    SLO_LATENCIA_MAXIMA: "2ms"
    CRITICIDADE: "ALTA"
FIM_METADADOS

ESTRUTURA EstadoLexer
    posicao            : INTEIRO32
    linha              : INTEIRO32
    coluna             : INTEIRO32
    total_caracteres   : INTEIRO32
    tokens_processados : INTEIRO32
FIM_ESTRUTURA

REGRA_NEGOCIO LexerSelfHost
    IDENTIFICADOR_REGRA: "BR-COMP-004"
    RASTREIO_REQUISITO: "REQ-COMP-004"
    DESCRICAO: "Analisa iterativamente a sequencia de caracteres do codigo-fonte THZ e emite tokens estruturados."

    CONTRATO_ENTRADA
        EXIGE tamanho_fonte >= 0
    FIM_CONTRATO_ENTRADA

    OPERACAO TokenizarFonte(tamanho_fonte: INTEIRO32) : EstadoLexer
    INICIO
        VARIAVEL estado : EstadoLexer <- CRIAR EstadoLexer(
            posicao: 0,
            linha: 1,
            coluna: 1,
            total_caracteres: tamanho_fonte,
            tokens_processados: 0
        )

        EXIBA "[LEXER SELF-HOSTED v1.1] Processando buffer de " + tamanho_fonte + " caracteres..."
        
        # Etapa 1: Escaneamento de palavras-chave do cabecalho
        EXIBA "[LEXER] Escaneando delimitadores de cabecalho..."
        EXIBA "[LEXER] Token [1:1]  ➔ PALAVRA_CHAVE: 'FERRAMENTA'"
        EXIBA "[LEXER] Token [1:12] ➔ IDENTIFICADOR: 'CompiladorLexerSelfHost'"
        EXIBA "[LEXER] Token [3:1]  ➔ PALAVRA_CHAVE: 'METADADOS_ARQUITETURA'"

        # Etapa 2: Escaneamento de delimitadores de bloco e declaracoes
        EXIBA "[LEXER] Escaneando definicoes de ESTRUTURA e REGRA_NEGOCIO..."
        EXIBA "[LEXER] Token [12:1] ➔ PALAVRA_CHAVE: 'ESTRUTURA'"
        EXIBA "[LEXER] Token [12:11]➔ IDENTIFICADOR: 'EstadoLexer'"
        EXIBA "[LEXER] Token [20:1] ➔ PALAVRA_CHAVE: 'REGRA_NEGOCIO'"

        estado.tokens_processados <- 24
        estado.posicao <- tamanho_fonte
        
        EXIBA "[LEXER SELF-HOSTED] Tokenizacao concluida. " + estado.tokens_processados + " tokens validados com sucesso."

        RETORNE estado
    FIM
FIM_REGRA_NEGOCIO

FIM_FERRAMENTA
