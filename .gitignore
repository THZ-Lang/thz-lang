# ==============================================================================
# THZ-LANG Global .gitignore
# ==============================================================================

# Node.js & TypeScript
node_modules/
dist/
dist/bin/*.exe
out/

# THZ-LANG build artifacts espurios
JVM/**/target/
JVM/**/dist/
**/*.ll

# Agents / AI tooling
.agents/
.opencode/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java, Maven & Gradle
target/
build/
.gradle/
*.class
# *.jar
# *.war
*.ear
dependency-reduced-pom.xml
surefire-reports/

# VS Code Extension Packaging
# *.vsix
Extensions/thz-lsp-vscode/dist/
Extensions/thz-lsp-vscode/out/

# IDEs and Editors
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db

# Environment & Secrets
.env
.env.*
!.env.example
*.local

# Logs and Scratch
*.log
scratch/
tmp/
temp/